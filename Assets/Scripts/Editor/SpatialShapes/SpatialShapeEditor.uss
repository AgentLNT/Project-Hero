.shape-editor { flex-grow: 1; }
.body { flex-grow: 1; flex-direction: row; min-height: 0; }
.sidebar { width: 300px; flex-shrink: 0; padding: 12px; }
.heading { font-size: 14px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 8px; }
.description { white-space: normal; margin-top: 8px; margin-bottom: 8px; }
.row { flex-direction: row; margin-top: 4px; margin-bottom: 4px; }
.row > Button { flex-grow: 1; }
.workspace { flex-grow: 1; min-width: 0; }
.canvas-title { padding: 12px; -unity-font-style: bold; }
.canvas-legend { padding-left: 12px; padding-right: 12px; padding-bottom: 8px; white-space: normal; }
.hidden { display: none; }
.shape-canvas { flex-grow: 1; min-height: 260px; overflow: hidden; background-color: #17212c; }
.status { padding: 8px; white-space: normal; }
.sidebar .unity-base-field { flex-direction: column; margin-bottom: 8px; }
.sidebar .unity-base-field__label { min-width: 0; margin-bottom: 4px; }
.sidebar Button { margin-top: 3px; margin-bottom: 3px; min-height: 24px; }
